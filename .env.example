# Copy this file to .env and fill in the values
# DO NOT commit .env to git

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default for local dev — no extra services needed)
DATABASE_URL=sqlite:///./materials_al.db

# PostgreSQL (for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/materials_al

# ── Application ──────────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=change-me-to-a-long-random-string-in-production

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── Storage ──────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MODEL_DIR=./models
DATASET_CACHE_DIR=./data/processed

# ── ML Defaults ──────────────────────────────────────────────────────────────
DEFAULT_MODEL_TYPE=gp
DEFAULT_STRATEGY=puda
DEFAULT_INITIAL_SAMPLES=100
DEFAULT_BATCH_SIZE=20
DEFAULT_TOTAL_BUDGET=300
DEFAULT_RANDOM_SEED=42
